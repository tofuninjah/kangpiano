# Names only, never values. Real values live in Vercel project settings
# (Production and Preview) and in a local, uncommitted .env.

# Contact form (src/pages/api/contact.ts). Read through process.env at
# request time, so they never reach the browser bundle.
RESEND_API_KEY=
# Where lesson requests are delivered (Hyejeong's inbox).
CONTACT_FORM_TO_EMAIL=
# Must be on a domain verified in Resend. Until her domain exists, use
# Resend's sandbox sender, which only delivers to the Resend account owner.
CONTACT_FORM_FROM_EMAIL=

# Client-visible: anything prefixed PUBLIC_ ships to the browser.
# Publishable keys only.
