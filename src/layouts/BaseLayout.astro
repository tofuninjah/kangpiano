---
// Fonts are self-hosted through Fontsource. Each CSS file declares latin,
// latin-ext and vietnamese faces with unicode-range, so browsers download
// only the subsets a page uses. Latin covers the ʻokina (U+02BB); kahakō
// vowels such as ā pull in latin-ext.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { copy } from '../data/copy';
import {
  DEFAULT_LOCALE,
  LOCALE_DETAILS,
  alternatePaths,
  unlocalizePath,
  type Locale,
} from '../lib/i18n';
import { toJsonLdScript } from '../lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  /** Keep utility pages (form results) out of search results. */
  noindex?: boolean;
  /** schema.org data rendered as JSON-LD (the home page passes it). */
  structuredData?: unknown;
  /** The page's language; pages under /ko pass 'ko'. */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const text = copy[locale];
const {
  title = text.meta.title,
  description = text.meta.description,
  noindex = false,
  structuredData,
} = Astro.props;

const { tag, og } = LOCALE_DETAILS[locale];
// The page's path without its language prefix, shared by every language.
const path = unlocalizePath(Astro.url.pathname);
const alternates = alternatePaths(path);

// Absolute URLs need `site`, which waits on the domain; until then these
// tags are simply left out.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
// hreflang: each translated page lists every language, itself included,
// and sends everyone else to English.
const hreflangs = Astro.site
  ? [
      ...alternates.map((alternate) => ({
        hreflang: LOCALE_DETAILS[alternate.locale].tag,
        href: new URL(alternate.path, Astro.site).href,
      })),
      ...alternates
        .filter((alternate) => alternate.locale === DEFAULT_LOCALE)
        .map((alternate) => ({
          hreflang: 'x-default',
          href: new URL(alternate.path, Astro.site).href,
        })),
    ]
  : [];
const ogAlternates = alternates
  .filter((alternate) => alternate.locale !== locale)
  .map((alternate) => LOCALE_DETAILS[alternate.locale].og);
---

<!doctype html>
<html lang={tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangs.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={text.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={og} />
    {ogAlternates.map((alternate) => (
      <meta property="og:locale:alternate" content={alternate} />
    ))}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {structuredData !== undefined && (
      <script
        is:inline
        type="application/ld+json"
        set:html={toJsonLdScript(structuredData)}
      />
    )}
    <!-- The hero headline is set in Newsreader; preload it to avoid a late swap. -->
    <link
      rel="preload"
      href={newsreaderLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <!-- Bottom padding on phones reserves room for the fixed CallBar (77px + safe area). -->
  <body class="flex min-h-dvh flex-col bg-plaster pb-[calc(4.8125rem+env(safe-area-inset-bottom))] text-ink md:pb-0">
    <a
      href="#main"
      class="sr-only rounded-full bg-quink text-ui font-semibold text-paper focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-5 focus:py-3"
    >
      {text.skipLink}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <CallBar locale={locale} />
  </body>
</html>
