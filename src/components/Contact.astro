---
import { copy } from '../data/copy';
import { site } from '../data/site';
import {
  CONTACT_LIMITS,
  HONEYPOT_FIELD,
  LOCALE_FIELD,
  OTHER_TOWN,
  townOptions,
} from '../lib/contact';
import type { Locale } from '../lib/i18n';
import FormField from './FormField.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = copy[locale];
const text = all.contact;

// Option values stay the English names the server checks against;
// only the visible label is translated.
const townLabel = (town: string) =>
  town === OTHER_TOWN ? text.otherTown : all.townName(town);

// Each control points at its hint (if any) and its error message slot.
const describedBy = (id: string, hint = false) =>
  [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');

const control =
  'h-14 w-full rounded-sm border border-field bg-paper px-4 text-base text-ink in-[form:not([novalidate])]:user-invalid:border-error aria-[invalid=true]:border-error';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="border-t border-staff bg-paper"
>
  <div class="mx-auto flex max-w-page flex-col gap-10 px-5 py-16 md:px-12 md:py-24 lg:flex-row lg:gap-16 xl:gap-24 xl:px-24 xl:py-30">
    <div class="flex flex-col gap-6 lg:w-[22rem] lg:shrink-0 xl:w-[32.5rem]">
      <p class="text-label font-semibold text-pencil uppercase">
        {text.eyebrow}
      </p>
      <h2
        id="contact-heading"
        class="font-serif text-h2-sm font-light lg:text-h2"
      >
        {text.heading.lead}{' '}
        <em class="whitespace-nowrap">{text.heading.emphasis}</em>
      </h2>
      <p class="text-body">{text.intro}</p>
      <div class="flex flex-col gap-1.5 pt-2">
        <p class="text-label font-semibold text-pencil uppercase">
          {text.callLabel}
        </p>
        <a
          href={site.phone.href}
          class="font-serif text-h2-sm text-quink underline-offset-8 hover:underline lg:text-quote"
        >
          {site.phone.display}
        </a>
      </div>
    </div>

    <form
      method="post"
      action="/api/contact"
      class="flex flex-1 flex-col gap-5"
      aria-labelledby="contact-heading"
      data-contact-form
    >
      <input type="hidden" name={LOCALE_FIELD} value={locale} />
      <div class="flex flex-col gap-5 md:flex-row">
        <FormField id="contact-name" label={text.name} class="md:flex-1">
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            maxlength={CONTACT_LIMITS.name}
            aria-describedby={describedBy('contact-name')}
            class={control}
          />
        </FormField>
        <FormField id="contact-reply" label={text.contact} class="md:flex-1">
          <input
            id="contact-reply"
            name="contact"
            type="text"
            required
            maxlength={CONTACT_LIMITS.contact}
            aria-describedby={describedBy('contact-reply')}
            class={control}
          />
        </FormField>
      </div>

      <div class="flex flex-col gap-5 md:flex-row md:items-start">
        <FormField
          id="contact-age"
          label={text.age}
          optional={text.optional}
          hint={text.ageHint}
          class="md:flex-1"
        >
          <input
            id="contact-age"
            name="age"
            type="text"
            maxlength={CONTACT_LIMITS.age}
            aria-describedby={describedBy('contact-age', true)}
            class={control}
          />
        </FormField>
        <FormField id="contact-town" label={text.town} class="md:flex-1">
          <div class="relative">
            <select
              id="contact-town"
              name="town"
              required
              aria-describedby={describedBy('contact-town')}
              class={`${control} appearance-none pr-10`}
            >
              <option value="">{text.townPlaceholder}</option>
              {townOptions().map((town) => (
                <option value={town}>{townLabel(town)}</option>
              ))}
            </select>
            <svg
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-ink"
            >
              <path
                d="M3 5l4 4 4-4"
                stroke="currentColor"
                stroke-width="1.5"
              ></path>
            </svg>
          </div>
        </FormField>
      </div>

      <FormField
        id="contact-message"
        label={text.message}
        optional={text.optional}
      >
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          maxlength={CONTACT_LIMITS.message}
          aria-describedby={describedBy('contact-message')}
          class={`${control} h-auto min-h-30 resize-y py-3`}
        ></textarea>
      </FormField>

      <!-- Honeypot: hidden from people and assistive tech; bots tend to fill it. -->
      <div
        aria-hidden="true"
        class="absolute -left-[9999px] h-px w-px overflow-hidden"
      >
        <label for="contact-website">{text.honeypot}</label>
        <input
          id="contact-website"
          name={HONEYPOT_FIELD}
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center sm:gap-6">
        <button
          type="submit"
          class="rounded-full bg-quink px-[1.875rem] py-[1.125rem] text-ui font-semibold text-paper transition-colors hover:bg-ink sm:w-fit"
        >
          {text.submit}
        </button>
        <p class="text-small text-pencil">{text.privacyNote}</p>
      </div>
      <p
        id="contact-status"
        role="status"
        class="text-body font-semibold data-[tone=error]:text-error data-[tone=success]:text-quink"
      ></p>
    </form>
  </div>
</section>

<script>
  // Progressive enhancement: without this script the form posts normally,
  // the browser's own required checks run, and the post lands on the
  // result page for the form's language. With it, the fields are checked
  // here first, with errors next to the fields instead of the browser's
  // bubbles, and the request goes in the background. Every message is in
  // the language of the form's hidden locale field.
  import { CONTACT_MESSAGES, LOCALE_FIELD, fieldError } from '../lib/contact';
  import { DEFAULT_LOCALE, isLocale } from '../lib/i18n';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.getElementById('contact-status');
  const button = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]'
  );

  if (form && status && button) {
    const localeField = form.elements.namedItem(LOCALE_FIELD);
    const localeValue =
      localeField instanceof HTMLInputElement ? localeField.value : '';
    const locale = isLocale(localeValue) ? localeValue : DEFAULT_LOCALE;
    const messages = CONTACT_MESSAGES[locale];
    // The script takes over from the browser's bubbles; the `required`
    // attributes stay for the no-JavaScript post.
    form.noValidate = true;
    const idleLabel = button.textContent;
    let sending = false;
    // Fields are checked as they're left only after a first send attempt, so
    // nobody is told off for tabbing through an empty form.
    let attempted = false;

    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const isField = (target: unknown): target is Field =>
      target instanceof HTMLInputElement ||
      target instanceof HTMLSelectElement ||
      target instanceof HTMLTextAreaElement;

    const setStatus = (message: string, tone: 'success' | 'error') => {
      status.dataset.tone = tone;
      status.textContent = message;
    };

    const setError = (control: Element, message: string | undefined) => {
      const slot = document.getElementById(`${control.id}-error`);
      if (slot) {
        slot.textContent = message ?? '';
        slot.hidden = !message;
      }
      if (message) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
    };

    const clearErrors = () => {
      for (const control of form.querySelectorAll('[aria-invalid]')) {
        setError(control, undefined);
      }
    };

    const showErrors = (errors: Record<string, string>) => {
      let first: HTMLElement | undefined;
      for (const [field, message] of Object.entries(errors)) {
        const control = form.elements.namedItem(field);
        if (!(control instanceof HTMLElement)) continue;
        setError(control, message);
        first ??= control;
      }
      first?.focus();
    };

    /** The checks the visitor can fix here, in field order. */
    const checkFields = (): Record<string, string> => {
      const errors: Record<string, string> = {};
      for (const control of form.elements) {
        if (!isField(control) || !control.name) continue;
        const message = fieldError(control.name, control.value, locale);
        if (message) errors[control.name] = message;
      }
      return errors;
    };

    // Editing a flagged field keeps its message current and clears it as
    // soon as the value passes; errors only the server can judge clear on
    // any edit. Nothing changes while a request is in flight, so the answer
    // lands on a clean form.
    form.addEventListener('input', (event) => {
      const control = event.target;
      if (sending || !isField(control)) return;
      if (!control.hasAttribute('aria-invalid')) return;
      setError(control, fieldError(control.name, control.value, locale));
    });

    // After a first attempt, leaving a field that's still wrong flags it.
    // Not when the whole window loses focus: the visitor may be mid-typing.
    form.addEventListener('focusout', (event) => {
      const control = event.target;
      if (!attempted || sending || !isField(control)) return;
      if (!document.hasFocus()) return;
      const message = fieldError(control.name, control.value, locale);
      if (message) setError(control, message);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      attempted = true;
      status.textContent = '';
      clearErrors();

      const errors = checkFields();
      if (Object.keys(errors).length > 0) {
        setStatus(messages.checkFields, 'error');
        showErrors(errors);
        return;
      }

      sending = true;
      // aria-disabled rather than disabled, so focus stays on the button.
      button.setAttribute('aria-disabled', 'true');
      button.textContent = messages.sending;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = (await response.json().catch(() => null)) as {
          ok?: boolean;
          message?: string;
          errors?: Record<string, string>;
        } | null;

        if (response.ok && result?.ok) {
          form.reset();
          attempted = false;
          setStatus(messages.success, 'success');
        } else {
          setStatus(result?.message ?? messages.sendFailed, 'error');
          if (result?.errors) showErrors(result.errors);
        }
      } catch {
        setStatus(messages.offline, 'error');
      } finally {
        sending = false;
        button.removeAttribute('aria-disabled');
        button.textContent = idleLabel;
      }
    });
  }
</script>
