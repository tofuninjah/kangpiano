---
import { copy } from '../data/copy';
import { site } from '../data/site';
import type { Locale } from '../lib/i18n';
import TownList from './TownList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = copy[locale];
---

<footer class="bg-ink">
  <div class="mx-auto flex max-w-page flex-col gap-4 px-5 py-8 md:flex-row md:items-center md:justify-between md:px-12 lg:py-9 xl:px-24">
    <p class="font-serif text-wordmark-sm text-plaster">
      {text.name} <span class="text-stone italic">{text.instruments}</span>
    </p>
    <TownList
      towns={site.towns.map(text.townName)}
      class="text-small text-stone"
    />
    <a
      href={site.phone.href}
      class="text-small text-plaster underline-offset-4 hover:underline focus-visible:outline-plaster"
    >
      {site.phone.display}
    </a>
  </div>
</footer>
