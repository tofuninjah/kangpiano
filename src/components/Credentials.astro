---
const credentials = [
  { title: 'Mokwon University', detail: 'Music graduate, Daejeon, Korea' },
  { title: 'Hawaiʻi & Korea', detail: 'Many years of teaching in both' },
  { title: 'Every age & level', detail: 'First-timers to returning adults' },
];
---

<div class="mx-auto max-w-page px-5 md:px-12 xl:px-24">
  <ul class="grid divide-y divide-staff border-t border-b border-t-ink border-b-staff lg:grid-cols-3 lg:divide-x lg:divide-y-0">
    {credentials.map((item) => (
      <li class="flex flex-col gap-1.5 py-5 md:py-6 lg:px-6 lg:py-7 lg:first:pl-0 xl:px-8">
        <span class="font-serif text-item">{item.title}</span>
        <span class="text-small text-pencil">{item.detail}</span>
      </li>
    ))}
  </ul>
</div>
