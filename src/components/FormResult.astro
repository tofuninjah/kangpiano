---
// Shared body for the pages a no-JavaScript form post lands on.
import { copy } from '../data/copy';
import { site } from '../data/site';
import { homeSectionHref, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  eyebrow: string;
  heading: string;
  body: string;
}

const { locale, eyebrow, heading, body } = Astro.props;
const text = copy[locale];
---

<section
  aria-labelledby="result-heading"
  class="mx-auto flex max-w-page flex-col gap-6 px-5 py-16 md:px-12 md:py-24 xl:px-24 xl:py-32"
>
  <p class="text-label font-semibold text-pencil uppercase">{eyebrow}</p>
  <h1
    id="result-heading"
    class="max-w-[40rem] font-serif text-h2-sm font-light lg:text-h2"
  >
    {heading}
  </h1>
  <p class="max-w-[35rem] text-body">{body}</p>
  <div class="flex flex-wrap items-center gap-6 pt-2">
    <a
      href={site.phone.href}
      class="rounded-full bg-quink px-[1.875rem] py-[1.125rem] text-ui font-semibold text-paper transition-colors hover:bg-ink"
    >
      {text.callNumber(site.phone.display)}
    </a>
    <a
      href={homeSectionHref('contact', locale)}
      class="border-b-[1.5px] border-quink pb-1 text-ui font-semibold text-quink"
    >
      {text.formResult.back}
    </a>
  </div>
</section>
