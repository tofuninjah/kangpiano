---
import { lessons, lessonsIntro } from '../data/lessons';
---

<section id="lessons" aria-labelledby="lessons-heading" class="bg-ink">
  <div class="mx-auto flex max-w-page flex-col gap-10 px-5 py-16 md:px-12 md:py-24 lg:flex-row lg:gap-16 xl:gap-24 xl:px-24 xl:py-30">
    <div class="flex flex-col gap-4 lg:w-[22rem] lg:shrink-0 xl:w-[26.25rem]">
      <p class="text-label font-semibold text-stone uppercase">Lessons</p>
      <h2
        id="lessons-heading"
        class="font-serif text-h2-sm font-light text-plaster lg:text-h2"
      >
        Lessons shaped around <em class="whitespace-nowrap">the student.</em>
      </h2>
      <p class="text-lead-sm text-stone">{lessonsIntro}</p>
    </div>

    <ol class="flex-1 border-b border-ink-rule lg:pt-2">
      {lessons.map((lesson, index) => (
        <li class="flex gap-5 border-t border-ink-rule py-6 md:gap-8">
          <span
            aria-hidden="true"
            class="w-10 shrink-0 font-serif text-index text-quink-light italic"
          >
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="flex flex-col gap-1.5">
            <h3 class="font-serif text-day text-plaster md:text-item">
              {lesson.title}
            </h3>
            <p class="text-base/5 text-stone">{lesson.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
