---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { copy } from '../data/copy';
import type { Locale } from '../lib/i18n';
import WhyPiano from './WhyPiano.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const about = copy[locale].about;

// No portrait exists yet. Adding src/assets/images/portrait.(jpg|png|webp)
// switches to Paper's photo-and-text layout; until then the section is
// text-only rather than shipping a placeholder box.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/portrait.{jpg,jpeg,png,webp}',
  { eager: true }
);
const portrait = Object.values(portraits)[0]?.default;
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="mx-auto max-w-page px-5 py-16 md:px-12 md:py-24 xl:px-24 xl:py-32"
>
  {portrait ? (
    <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:gap-16 xl:gap-24">
      <Image
        src={portrait}
        alt={about.portraitAlt}
        widths={[480, 800, 1040]}
        sizes="(min-width: 1280px) 520px, (min-width: 1024px) 40vw, calc(100vw - 2.5rem)"
        class="aspect-[4/5] w-full rounded-sm object-cover lg:w-[40%] lg:shrink-0 xl:w-[32.5rem]"
      />
      <div class="flex flex-1 flex-col gap-6 md:gap-8">
        <h2
          id="about-heading"
          class="text-label font-semibold text-pencil uppercase"
        >
          {about.heading}
        </h2>
        <blockquote class="font-serif text-quote-sm font-light text-balance lg:text-quote">
          <p>
            “{about.quote.lead}{' '}
            <em class="text-quink">{about.quote.emphasis}”</em>
          </p>
        </blockquote>
        <p class="text-body">{about.bio}</p>
        <WhyPiano locale={locale} />
      </div>
    </div>
  ) : (
    <>
      <div class="flex flex-col gap-8 lg:flex-row lg:gap-16 xl:gap-24">
        <div class="flex flex-col gap-6 md:gap-8 lg:w-7/12">
          <h2
            id="about-heading"
            class="text-label font-semibold text-pencil uppercase"
          >
            {about.heading}
          </h2>
          <blockquote class="font-serif text-quote-sm font-light text-balance lg:text-quote">
            <p>
              “{about.quote.lead}{' '}
              <em class="text-quink">{about.quote.emphasis}”</em>
            </p>
          </blockquote>
        </div>
        <p class="text-body lg:flex-1 lg:pt-10">{about.bio}</p>
      </div>
      {/* Below both columns so the opened text gets the full width. */}
      <div class="mt-10 md:mt-14">
        <WhyPiano locale={locale} wide />
      </div>
    </>
  )}
</section>
