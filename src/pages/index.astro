---
// Placeholder content until the header and hero land (rebuild steps 3–4).
// It exercises the type tokens so fonts can be checked against Paper.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="mx-auto flex max-w-page flex-col gap-6 px-5 pt-8 pb-16 md:px-12 lg:gap-9 lg:px-24 lg:pt-24 lg:pb-28">
    <p class="text-label font-semibold text-pencil uppercase">
      Private lessons · Oʻahu · All ages
    </p>
    <h1 class="max-w-[42.5rem] font-serif text-display-sm font-light lg:text-display">
      Piano lessons in your living room, <em class="text-quink">or mine.</em>
    </h1>
    <p class="max-w-[35rem] text-lead">
      I teach at your home in ʻEwa Beach and Kapolei, and at my home in
      Mililani.
    </p>
    <p>
      <a
        href={site.phone.href}
        class="inline-block rounded-full bg-quink px-[1.875rem] py-[1.125rem] text-ui font-semibold text-paper"
      >
        Call {site.phone.display}
      </a>
    </p>
  </section>
</BaseLayout>
